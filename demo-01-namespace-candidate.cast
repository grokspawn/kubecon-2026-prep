[0.002, "o", "\r\n\u001b[1;35m### 6. Exercise the operator's API\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ cat /Users/jordan/Documents/devel/kubecon-2026-demos/demos/01-direct-bundle-install/manifests/kubecondemo-example.yaml\u001b[0m\r\n"]
[0.003, "o", "apiVersion: demo.kubecon.io/v1alpha1\r\nkind: KubeconDemo\r\nmetadata:\r\n  name: example\r\n  namespace: kubecon-demo-operator-system\r\nspec:\r\n  message: hello kubecon\r\n"]
