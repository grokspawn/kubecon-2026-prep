[0.002, "o", "\r\n\u001b[1;35m### 7. Delete the ClusterExtension; its managed namespace and CRD (including their contents) are deleted\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig delete clusterextension kubecon-demo-operator --timeout=120s\u001b[0m\r\n"]
