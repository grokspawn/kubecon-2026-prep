{"version":3,"term":{"cols":80,"rows":24},"timestamp":1793223644,"idle_time_limit":2.0,"command":"./run.sh","env":{"SHELL":"/bin/zsh"}}
[0.165, "o", "\r\n\u001b[1;35m### Resetting the demo extension (its managed namespace and CRD contents may be deleted)\u001b[0m\r\n"]
[0.278, "o", "\r\n\u001b[1;35m### 1. Starting point: an OLMv1 cluster with no catalogs and no extensions\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig get clustercatalogs 2>&1 | head -2\u001b[0m\r\n"]
[0.042, "o", "No resources found\r\n"]
[0.001, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig get clusterextensions 2>&1 | head -2\u001b[0m\r\n"]
[0.042, "o", "No resources found\r\n"]
[0.001, "o", "\r\n\u001b[1;35m### 2. The install source is a plain registry+v1 bundle image\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ skopeo inspect --insecure-policy --tls-verify=false docker://localhost:55000/bundles/kubecon-demo-operator-bundle:v0.1.0 | jq -r '.Labels, .Digest'\u001b[0m\r\n"]
[0.119, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"org.opencontainers.image.title\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"kubecon-demo-operator-bundle\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"org.opencontainers.image.version\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"0.1.0\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\nsha256:27458d363682589ca8fa1a508db16c1fe0cdca228b3d01088479790e546ce5dc\r\n"]
[0.002, "o", "\u001b[1;36m$ cat /Users/jordan/Documents/devel/kubecon-2026-demos/demos/01-direct-bundle-install/manifests/clusterextension.yaml\u001b[0m\r\n"]
[0.004, "o", "# Direct bundle install: no ClusterCatalog, no dependency resolution.\r\n# The ClusterExtension points straight at a registry+v1 bundle image.\r\n# Omitting spec.namespace enables the system-managed namespace path.\r\napiVersion: olm.operatorframework.io/v1\r\nkind: ClusterExtension\r\nmetadata:\r\n  name: kubecon-demo-operator\r\nspec:\r\n  source:\r\n    sourceType: OCIImage\r\n    ociImage:\r\n      ref: docker-registry.kubecon-demo-registry.svc.cluster.local:5000/bundles/kubecon-demo-operator-bundle:v0.1.0\r\n"]
[0.000, "o", "\r\n\u001b[1;35m### 3. Apply the ClusterExtension without spec.namespace; OLM creates the install namespace\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig apply -f /Users/jordan/Documents/devel/kubecon-2026-demos/demos/01-direct-bundle-install/manifests/clusterextension.yaml\u001b[0m\r\n"]
[0.058, "o", "clusterextension.olm.operatorframework.io/kubecon-demo-operator created\r\n"]
[0.001, "o", "\r\n\u001b[1;35m### 4. Watch installation progress\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig wait --for=condition=Available clusterextension/kubecon-demo-operator --timeout=300s\u001b[0m\r\n"]
[1.038, "o", "clusterextension.olm.operatorframework.io/kubecon-demo-operator condition met\r\n"]
[0.003, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig get clusterextension kubecon-demo-operator -o yaml | sed -n '/status:/,$p'\u001b[0m\r\n"]
