[0.000, "o", "\r\n\u001b[1;35m### 5. The managed namespace belongs to a ClusterObjectSet revision beneath the ClusterObjectDeployment\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig get namespace kubecon-demo-operator-system -o json | jq '{name: .metadata.name, owners: .metadata.ownerReferences}'\u001b[0m\r\n"]
[0.039, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"kubecon-demo-operator-system\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"owners\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"apiVersion\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"olm.operatorframework.io/v1\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"blockOwnerDeletion\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"controller\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"kind\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"ClusterObjectSet\"\u001b[0m\u001b[1;39m,\r\n"]
